import json
import sys

if len(sys.argv) != 4:

    print(
        "usage: track_id old_state new_state"
    )

    raise SystemExit

track_id = int(sys.argv[1])
old_state = sys.argv[2]
new_state = sys.argv[3]

manifest_path = (
    "generated/track_acquisition_manifest.json"
)

manifest = json.load(
    open(
        manifest_path,
        encoding="utf-8"
    )
)

updated = False

for track in manifest:

    if (
        track["track_id"] == track_id
        and
        track["state"] == old_state
    ):

        track["state"] = new_state

        updated = True

        break

with open(
    manifest_path,
    "w",
    encoding="utf-8"
) as fp:

    json.dump(
        manifest,
        fp,
        indent=2
    )

print(
    "updated:",
    updated
)
